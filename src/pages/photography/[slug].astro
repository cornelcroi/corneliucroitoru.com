---
import { Image, getImage } from "astro:assets";
import Base from "../../layouts/Base.astro";
import { SITE } from "../../site";
import { PHOTO_QUALITY, getSeries, shootingParts } from "../../lib/content";

export async function getStaticPaths() {
  const series = await getSeries();
  const n = series.length;
  return series.map((s, i) => ({
    params: { slug: s.id },
    props: { series: s, prev: series[(i - 1 + n) % n], next: series[(i + 1) % n] },
  }));
}

const { series, prev, next } = Astro.props;
const { title, description, year, photos } = series.data;
// One set of variants per photo; the link opens the largest one, so nothing is generated twice.
const images = await Promise.all(
  photos.map((p) => getImage({ src: p.src, widths: [800, 1600], format: "webp", quality: PHOTO_QUALITY })),
);
const largest = (img: (typeof images)[number]) => img.srcSet.values.at(-1)?.url ?? img.src;
const og = await getImage({ src: series.data.cover, width: 1200, format: "jpg" });

// Two portraits in a row share a line; everything else gets its own.
const ratio = (i: number) => photos[i].src.width / photos[i].src.height;
const isPortrait = (i: number) => ratio(i) < 1;
const rows: number[][] = [];
for (let i = 0; i < photos.length; i++) {
  if (isPortrait(i) && i + 1 < photos.length && isPortrait(i + 1)) rows.push([i, ++i]);
  else rows.push([i]);
}
---
<Base title={title} description={description ?? `${title}${year ? `, ${year}` : ""}: ${photos.length} travel photographs by ${SITE.name}, with the camera settings under each one.`} image={og.src} imageAlt={`${title}, photograph by ${SITE.name}`}>
  <main class="wrap">
    <header class="series__head">
      <a class="meta" href="/photography/">← Photography</a>
      <h1 class="page-title">{title}</h1>
      <p class="meta">{[year, `${photos.length} photographs`].filter(Boolean).join(" · ")}</p>
      {description && <p class="page-lede">{description}</p>}
    </header>

    {rows.map((row) => (
      <div class:list={["row", { "row--pair": row.length === 2 }]} style={`--ratios: ${row.reduce((sum, i) => sum + ratio(i), 0)}`}>
        {row.map((i) => (
          <figure style={`--ratio: ${ratio(i)}`}>
            <a href={largest(images[i])}>
              <img src={images[i].src} srcset={images[i].srcSet.attribute}
                sizes={row.length === 2 ? "(max-width: 560px) 100vw, 560px" : "(max-width: 1180px) 100vw, 1120px"}
                width={photos[i].src.width} height={photos[i].src.height}
                alt={`${title}, photograph ${i + 1}`} loading={i < 2 ? "eager" : "lazy"} decoding="async" />
            </a>
            {shootingParts(photos[i]).length > 0 && (
              <figcaption>{shootingParts(photos[i]).map((part) => <span>{part}</span>)}</figcaption>
            )}
          </figure>
        ))}
      </div>
    ))}

    <nav class="series__foot" aria-label="Other series">
      {[{ s: prev, label: "Previous" }, { s: next, label: "Next" }].map(({ s, label }) => (
        <a class="neighbour" href={`/photography/${s.id}/`}>
          <Image src={s.data.cover} alt="" widths={[300, 600]} sizes="160px" quality={PHOTO_QUALITY} />
          <span>
            <span class="meta">{label}</span>
            <span class="neighbour__title">{s.data.title}</span>
          </span>
        </a>
      ))}
    </nav>
  </main>
</Base>

<style>
  .series__head { display: flex; flex-direction: column; gap: 4px; margin: 32px 0 40px; }
  .series__head .page-title { margin-top: 24px; }

  .row { display: flex; gap: 14px; margin-bottom: 56px; }
  figure { margin: 0; flex: 1 1 0; min-width: 0; display: flex; flex-direction: column; gap: 8px; }
  figure img { display: block; width: 100%; height: auto; }
  /* No photo is taller than the screen. The width comes from the ratio, not the loaded file,
     so the space is reserved before a lazy image arrives and the caption starts at the photo's edge. */
  .row:not(.row--pair) figure { align-items: center; }
  .row:not(.row--pair) figure > * { width: min(100%, calc(88vh * var(--ratio))); }
  .row--pair { max-width: calc(88vh * var(--ratios) + 14px); margin-inline: auto; }
  .row--pair figure { flex: var(--ratio) 1 0; }

  figcaption { display: flex; flex-wrap: wrap; column-gap: 6px; font-size: 12px; letter-spacing: 0.01em; color: var(--faint); }
  figcaption span { white-space: nowrap; }
  /* The dot ends a line, never starts one: it belongs to the item before it. */
  figcaption span:not(:last-child)::after { content: "·"; margin-left: 6px; }

  .series__foot { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; padding-top: 32px; border-top: 1px solid var(--rule); }
  .neighbour { display: flex; align-items: center; gap: 16px; min-width: 0; }
  .neighbour:last-child { flex-direction: row-reverse; text-align: right; }
  .neighbour:hover { text-decoration: none; }
  .neighbour:hover .neighbour__title { text-decoration: underline; text-underline-offset: 3px; }
  .neighbour :global(img) { width: 160px; aspect-ratio: 3 / 2; object-fit: cover; flex-shrink: 0; }
  .neighbour > span { display: flex; flex-direction: column; gap: 2px; }
  .neighbour__title { font-family: var(--serif); font-size: 18px; font-weight: 600; }

  @media (max-width: 560px) {
    .row { flex-direction: column; margin-bottom: 40px; }
    .row--pair { max-width: none; }
    .row--pair figure { flex: none; align-items: center; }
    .row--pair figure > * { width: min(100%, calc(88vh * var(--ratio))); }
    /* A stacked pair is two photos like any other: same gap as between rows. */
    .row--pair { gap: 40px; }
    .series__foot { grid-template-columns: 1fr; }
    .neighbour :global(img) { width: 96px; }
    .neighbour__title { font-size: 16px; }
  }
</style>
