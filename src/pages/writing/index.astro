---
import Base from "../../layouts/Base.astro";
import PostRow from "../../components/PostRow.astro";
import { getAllPosts } from "../../lib/content";

const all = await getAllPosts();
const posts = all.filter((p) => !p.prototype), prototypes = all.filter((p) => p.prototype);
---
<Base title="Writing" description="Articles on building software with AI: the patterns that hold in production, with the code and numbers behind them.">
  <main class="wrap narrow">
    <h1 class="page-title">Writing</h1>
    <p class="page-lede">Patterns from building with AI. Each one links to something that runs.</p>
    {posts.map((post) => <PostRow post={post} />)}
    {prototypes.length > 0 && (
      <section id="prototypes" class="protos">
        <h2>Prototypes</h2>
        <p class="page-lede">Small tools I built for a real need at home. Open to try, not products.</p>
        {prototypes.map((post) => <PostRow post={post} />)}
      </section>
    )}
  </main>
</Base>

<style>
  .narrow { max-width: calc(760px + 2 * var(--gutter)); }
  .protos { margin-top: 64px; }
  .protos h2 { margin: 0 0 8px; font-family: var(--serif); }
</style>
