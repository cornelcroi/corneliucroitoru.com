---
import { render } from "astro:content";
import Base from "../../layouts/Base.astro";
import { formatDate, getArticles, readingMinutes } from "../../lib/content";

export async function getStaticPaths() {
  const articles = await getArticles();
  return articles.map((article) => ({ params: { slug: article.id }, props: { article } }));
}

const { article } = Astro.props;
const { Content } = await render(article);
const { title, description, date, cover, devto } = article.data;
---
<Base title={title} description={description} image={cover}>
  <article class="wrap article">
    <header class="article__head">
      <span class="meta">{formatDate(date)} · {readingMinutes(article.body ?? "")} min read</span>
      <h1>{title}</h1>
      <p class="article__lede">{description}</p>
    </header>
    {cover && <img class="article__cover" src={cover} alt="" width="1000" height="420">}
    <div class="prose">
      <Content />
    </div>
    <footer class="article__foot">
      {devto && <a href={devto}>Comments and discussion on dev.to →</a>}
      <a href="/writing/">← All writing</a>
    </footer>
  </article>
</Base>

<style>
  .article { max-width: calc(var(--read) + 2 * var(--gutter)); }
  .article__head { display: flex; flex-direction: column; gap: 14px; margin: 56px 0 32px; }
  .article__head h1 { margin: 0; font-family: var(--serif); font-size: clamp(32px, 5vw, 44px); line-height: 1.12; font-weight: 700; letter-spacing: -0.015em; }
  .article__lede { margin: 0; font-family: var(--serif); font-size: 21px; line-height: 1.45; color: var(--muted); }
  .article__cover { width: 100%; margin-bottom: 40px; }
  .article__foot { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 16px; margin-top: 56px; padding-top: 24px; border-top: 1px solid var(--rule); font-size: 15px; color: var(--faint); }

  .prose { font-family: var(--serif); font-size: 20px; line-height: 1.65; color: var(--ink); }
  .prose :global(p), .prose :global(ul), .prose :global(ol), .prose :global(blockquote) { margin: 0 0 1.2em; }
  .prose :global(h2) { font-family: var(--sans); font-size: 26px; line-height: 1.25; margin: 1.8em 0 0.6em; letter-spacing: -0.01em; }
  .prose :global(h3) { font-family: var(--sans); font-size: 21px; margin: 1.5em 0 0.5em; }
  .prose :global(a) { text-decoration: underline; text-underline-offset: 3px; text-decoration-thickness: 1px; }
  .prose :global(li) { margin-bottom: 0.4em; }
  .prose :global(blockquote) { padding-left: 20px; border-left: 3px solid var(--ink); font-style: italic; color: var(--text); }
  .prose :global(img) { margin: 1.5em 0; }
  .prose :global(code) { font-family: var(--mono); font-size: 0.8em; background: var(--code-bg); padding: 0.1em 0.35em; border-radius: 3px; }
  .prose :global(pre) { margin: 0 0 1.4em; padding: 18px 20px; overflow-x: auto; font-size: 15px; line-height: 1.55; border: 1px solid var(--rule); border-radius: 4px; background: var(--code-bg) !important; }
  .prose :global(pre code) { background: none; padding: 0; font-size: inherit; }
  .prose :global(table) { display: block; overflow-x: auto; border-collapse: collapse; margin: 0 0 1.4em; font-family: var(--sans); font-size: 15px; }
  .prose :global(th), .prose :global(td) { padding: 8px 12px; border-bottom: 1px solid var(--rule); text-align: left; vertical-align: top; }
  .prose :global(hr) { border: 0; border-top: 1px solid var(--rule); margin: 2.5em 0; }
</style>
