---
import { render } from "astro:content";
import Base from "../../layouts/Base.astro";
import { formatDate, getArticleSeries, getArticles, isLive, readingMinutes } from "../../lib/content";
import { SITE } from "../../site";
import { PERSON_ID } from "../../lib/seo";

export async function getStaticPaths() {
  const articles = await getArticles();
  return articles.map((article) => ({ params: { slug: article.id }, props: { article } }));
}

const { article } = Astro.props;
const { Content } = await render(article);
const { title, seoTitle, description, date, updated, cover, devto, tags, series, video } = article.data;
const parts = series ? await getArticleSeries(series) : [];
// Local dev only: say why an article is not on the live site yet.
const status = import.meta.env.DEV && !isLive(article.data)
  ? (article.data.draft ? "Draft: not on the live site" : `Scheduled: goes live on ${formatDate(date)}`)
  : null;
const url = `${SITE.url}/writing/${article.id}/`;
// 1200x630 version of the cover for link previews, made by scripts/make_share_images.sh.
const shareImage = cover ? `/og/writing/${article.id}.jpg` : undefined;
const posting = {
  "@type": "BlogPosting",
  "@id": `${url}#article`,
  headline: title,
  description,
  ...(date && { datePublished: date.toISOString() }),
  ...((updated ?? date) && { dateModified: (updated ?? date)!.toISOString() }),
  url,
  mainEntityOfPage: url,
  image: `${SITE.url}${shareImage ?? SITE.shareImage}`,
  author: { "@id": PERSON_ID },
  publisher: { "@id": PERSON_ID },
  keywords: tags.join(", "),
  inLanguage: "en",
  ...(series && { isPartOf: { "@type": "CreativeWorkSeries", name: series } }),
};
const videoObject = video && {
  "@type": "VideoObject",
  name: video.title,
  description: video.description,
  thumbnailUrl: `https://i.ytimg.com/vi/${video.youtube}/maxresdefault.jpg`,
  uploadDate: video.uploaded.toISOString(),
  duration: video.duration,
  embedUrl: `https://www.youtube.com/embed/${video.youtube}`,
  url: `https://www.youtube.com/watch?v=${video.youtube}`,
  author: { "@id": PERSON_ID },
};
---
<Base title={seoTitle ?? title} description={description} image={shareImage} imageAlt={title} type="article" published={date} schema={videoObject ? [posting, videoObject] : [posting]}>
  <article class="wrap article">
    <header class="article__head">
      {status && <span class="status">{status}</span>}
      <span class="meta">{[date && formatDate(date), `${readingMinutes(article.body ?? "")} min read`].filter(Boolean).join(" · ")}</span>
      <h1>{title}</h1>
      <p class="article__lede">{description}</p>
    </header>
    {cover && <img class="article__cover" src={cover} alt="" width="1000" height="420">}
    <div class="prose">
      <Content />
    </div>
    {parts.length > 1 && (
      <nav class="series" aria-label={series}>
        <span class="meta">Part {parts.findIndex((p) => p.id === article.id) + 1} of {parts.length} · {series}</span>
        <ol>
          {parts.map((p) => (
            <li>{p.id === article.id ? <span aria-current="page">{p.data.title}</span> : <a href={`/writing/${p.id}/`}>{p.data.title}</a>}</li>
          ))}
        </ol>
      </nav>
    )}
    <footer class="article__foot">
      {devto && <a href={devto}>Comments and discussion on dev.to →</a>}
      <a href="/writing/">← All writing</a>
    </footer>
  </article>
</Base>

<style>
  /* One width for everything: text, code, diagrams, video. */
  .article { max-width: calc(var(--figure) + 2 * var(--gutter)); }
  .article__head, .series, .article__foot { max-width: var(--read); margin-inline: auto; }
  .article__head { display: flex; flex-direction: column; gap: 14px; margin-block: 56px 32px; }
  .article__head h1 { margin: 0; font-family: var(--serif); font-size: clamp(32px, 5vw, 44px); line-height: 1.12; font-weight: 700; letter-spacing: -0.015em; }
  .status { align-self: flex-start; padding: 4px 10px; border-radius: 4px; background: #fff4d6; color: #7a5300; font-size: 13px; font-weight: 600; }
  .article__lede { margin: 0; font-family: var(--serif); font-size: 21px; line-height: 1.45; color: var(--muted); }
  .article__cover { width: 100%; max-width: var(--read); margin: 0 auto 40px; }
  .series { margin-top: 56px; margin-inline: auto; padding: 20px 24px; border: 1px solid var(--rule); border-radius: 4px; }
  .series ol { margin: 10px 0 0; padding-left: 1.3em; font-size: 16px; line-height: 1.5; }
  .series li { margin-bottom: 6px; }
  .series a { text-decoration: underline; text-underline-offset: 3px; text-decoration-thickness: 1px; }
  .series [aria-current] { color: var(--faint); }
  .article__foot { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 16px; margin-top: 56px; padding-top: 24px; border-top: 1px solid var(--rule); font-size: 15px; color: var(--faint); }
  /* "All writing" stays on the right, with or without a dev.to link before it. */
  .article__foot a:last-child { margin-left: auto; }

  .prose { font-family: var(--serif); font-size: 20px; line-height: 1.65; color: var(--ink); }
  .prose > :global(*) { max-width: var(--read); margin-inline: auto; }
  .prose > :global(p:has(img)), .prose > :global(video), .prose > :global(.video-embed) { max-width: var(--figure); }
  .prose :global(p:has(img) img) { width: 100%; }
  /* Two screens side by side, the same height: each link grows by its image's width-to-height ratio. */
  .prose > :global(.devices) { max-width: var(--figure); display: flex; align-items: center; gap: 24px; margin-block: 0 1.2em; }
  .prose :global(.devices figure) { flex: var(--ratio) 1 0; min-width: 0; margin: 0; }
  .prose :global(.devices img) { display: block; width: 100%; height: auto; margin: 0; }
  .prose :global(.devices figcaption) { margin-top: 10px; text-align: center; font-family: var(--sans); font-size: 15px; color: var(--faint); }
  /* A diagram links to its own file: one click opens it at full size. */
  .prose :global(a:has(> img)) { display: block; cursor: zoom-in; text-decoration: none; }
  .prose :global(p), .prose :global(ul), .prose :global(ol), .prose :global(blockquote) { margin-block: 0 1.2em; }
  .prose :global(h2) { font-family: var(--sans); font-size: 26px; line-height: 1.25; margin-block: 1.8em 0.6em; letter-spacing: -0.01em; }
  .prose :global(h3) { font-family: var(--sans); font-size: 21px; margin-block: 1.5em 0.5em; }
  .prose :global(a) { text-decoration: underline; text-underline-offset: 3px; text-decoration-thickness: 1px; }
  .prose :global(li) { margin-bottom: 0.4em; }
  .prose :global(blockquote) { padding-left: 20px; border-left: 3px solid var(--ink); font-style: italic; color: var(--text); }
  .prose :global(img) { margin-block: 1.5em; }
  .prose :global(.video-embed) { aspect-ratio: 16 / 9; margin-block: 1em 1.5em; border-radius: 6px; overflow: hidden; background: #000; }
  .prose :global(.video-embed iframe) { display: block; width: 100%; height: 100%; border: 0; }
  .prose :global(video) { display: block; width: 100%; height: auto; margin-block: 1.5em 0.6em; border-radius: 6px; background: #000; }
  .prose :global(code) { font-family: var(--mono); font-size: 0.8em; background: var(--code-bg); padding: 0.1em 0.35em; border-radius: 3px; }
  .prose :global(pre) { margin-block: 0 1.4em; padding: 18px 20px; overflow-x: auto; font-size: 15px; line-height: 1.55; border: 1px solid var(--rule); border-radius: 4px; background: var(--code-bg) !important; }
  .prose :global(pre code) { background: none; padding: 0; font-size: inherit; }
  /* Prompts are prose-like lines: they wrap. Code keeps its lines and scrolls; a regex cut in two reads as a bug. */
  .prose :global(pre[data-language="plaintext"]), .prose :global(pre[data-language="plaintext"] code) { white-space: pre-wrap; overflow-wrap: anywhere; }
  .prose :global(table) { width: 100%; border-collapse: collapse; margin-block: 0 1.4em; font-family: var(--sans); font-size: 15px; }
  .prose :global(th), .prose :global(td) { padding: 8px 12px; border-bottom: 1px solid var(--rule); text-align: left; vertical-align: top; }
  .prose :global(:is(th, td):first-child) { padding-left: 0; }
  .prose :global(:is(th, td):last-child) { padding-right: 0; }
  .prose :global(hr) { border: 0; border-top: 1px solid var(--rule); margin-block: 2.5em; }
  @media (max-width: 560px) {
    .prose { font-size: 18px; line-height: 1.6; }
    .prose :global(h2) { font-size: 23px; }
    .prose :global(pre) { font-size: 13px; padding: 14px 16px; }
    .prose :global(table) { font-size: 14px; }
    .prose :global(th), .prose :global(td) { padding: 8px 6px; }
    .prose > :global(.devices) { flex-direction: column; }
    .prose :global(.devices figure) { flex: none; width: 100%; }
    .prose :global(.devices figure:first-child) { width: 60%; }
    .article__lede { font-size: 19px; }
  }
</style>
