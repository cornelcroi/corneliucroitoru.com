---
import { Image } from "astro:assets";
import Base from "../layouts/Base.astro";
import { SITE } from "../site";
import { AGENT_SQUAD, BUILDING, PROTOTYPES } from "../data/projects";
import { PHOTO_QUALITY, formatDate, getAllPosts, getSeries } from "../lib/content";

const LATEST_POSTS = 3;
const PHOTO_TILES = 4;

// The two live products and the open source, in that order; the rest is on the Projects page.
const projects = [...BUILDING.filter((p) => p.name !== "BandBike"), AGENT_SQUAD];

const allPosts = await getAllPosts();
// The featured articles, newest first (owner, 2026-10-29: the home page shows range and production patterns,
// not the newest; it replaced « a new article shows on the home page the day it goes live » of 2026-10-05).
const posts = allPosts.filter((p) => p.featured).slice(0, LATEST_POSTS);
const series = await getSeries();
const heroSeries = series.find((s) => s.id === SITE.hero.series) ?? series[0];
const hero = heroSeries.data.photos[SITE.hero.photo] ?? heroSeries.data.photos[0];
const tiles = series.filter((s) => s.id !== heroSeries.id).slice(0, PHOTO_TILES);
---
<Base overlayNav fullTitle={`${SITE.name} · ${SITE.role}`}>
  <header class="hero">
    <Image src={hero.src} alt={heroSeries.data.title} widths={[800, 1200, 1600, 2000]} sizes="100vw" quality={PHOTO_QUALITY} loading="eager" fetchpriority="high" class="hero__img" />
    <div class="hero__shade"></div>
    <nav class="nav wrap hero__nav" aria-label="Main">
      <a class="nav__name" href="/">{SITE.name}</a>
      <div class="nav__links">
        <a href="/projects/">Projects</a><a href="/writing/">Writing</a><a href="/experience/">Experience</a><a href="/about/">About</a><a href="/photography/">Photography</a>
      </div>
    </nav>
    <div class="wrap hero__text">
      <h1>{SITE.tagline}</h1>
    </div>
    <a class="hero__caption" href={`/photography/${heroSeries.id}/`}>{SITE.hero.caption}</a>
  </header>

  <main class="wrap col">
    <section class="intro">
      <p class="intro__lead">20+ years of shipping software. GenAI since 2023: at AWS, at Betclic and in my own products.</p>
      <p>What I do best: take a business problem, find the architecture that fits, and build it, from the first prototype to production. At AWS I did it 30+ times with customers, 2 to 6 weeks each. Before GenAI, I was a cloud architect for hundreds of AWS customers.</p>
      <p>Today at Betclic, as Staff GenAI Solutions Architect, I review GenAI projects, build prototypes with product teams and lead MCP adoption.</p>
      <p>I do it for myself too: <a href="https://streetlensapp.com">StreetLens</a> and <a href="https://www.backfrommytrip.com">Back From My Trip</a>, two products I co-founded, both live.</p>
      <dl class="stats">
        <div><dt>30+</dt><dd>GenAI prototypes built with AWS customers</dd></div>
        <div><dt>2</dt><dd>products I co-founded, both live</dd></div>
        <div><dt>7.7k</dt><dd>GitHub stars on Agent Squad</dd></div>
        <div><dt>10</dt><dd>talks, including AWS re:Invent</dd></div>
      </dl>
      <a class="more" href="/experience/">Full experience →</a>
    </section>

    <section class="block">
      <div class="block__head"><h2>Projects</h2></div>
      {projects.map((p) => (
        <article class="card">
          {p.image && <a class="card__shot" href={p.url} tabindex="-1"><img src={p.image.src} alt={p.image.alt} width={p.image.width} height={p.image.height} loading="lazy" decoding="async"></a>}
          <div class="card__text">
            <h3><a href={p.url}>{p.name}</a></h3>
            {p.proof && <p class="card__proof">{p.proof}</p>}
            <p class="card__excerpt">{p.short ?? p.line}</p>
            <p class="meta">{[p.role, p.when].filter(Boolean).join(" · ")}</p>
            {p.links && <p class="card__links">{p.links.map((l) => <a href={l.url}>{l.label} ↗</a>)}</p>}
          </div>
        </article>
      ))}
      <p class="protos"><strong>Always building something.</strong> Some of my prototypes:{" "}
        {PROTOTYPES.map((p, i) => <><a href={p.url}>{p.name}</a>{i < PROTOTYPES.length - 1 ? ", " : ". "}</>)}
        <a class="protos__all" href="/projects/#prototypes">All of them →</a></p>
      <a class="more" href="/projects/">All projects →</a>
    </section>

    <section class="block">
      <div class="block__head"><h2>Writing</h2></div>
      {posts.map((post) => (
        <a class="post" href={post.href}>
          <span class="post__title">{post.title}</span>
          <span class="post__excerpt">{post.description}</span>
          <span class="meta">{[post.date && formatDate(post.date), post.where ? `${post.where} ↗` : `${post.minutes} min read`].filter(Boolean).join(" · ")}</span>
        </a>
      ))}
      <a class="more" href="/writing/">Read all {allPosts.length} articles →</a>
    </section>

    <section class="block">
      <div class="block__head"><h2>Photography</h2></div>
      <p class="block__lede">My other passion. I shoot the places I travel to, mostly on my iPhone now.</p>
      <div class="tiles">
        {tiles.map((s) => (
          <a href={`/photography/${s.id}/`} class="tile">
            <Image src={s.data.cover} alt={s.data.title} widths={[400, 700]} sizes="(max-width: 640px) 50vw, 180px" quality={PHOTO_QUALITY} />
            <span class="meta">{s.data.title}</span>
          </a>
        ))}
      </div>
      <a class="more" href="/photography/">See all {series.length} series →</a>
    </section>
  </main>
</Base>

<style>
  .hero { position: relative; height: min(440px, 52vh); min-height: 340px; overflow: hidden; color: #fff; }
  .hero__img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .hero__shade { position: absolute; inset: 0; background: linear-gradient(180deg, rgba(10,12,16,.45) 0%, rgba(10,12,16,0) 30%, rgba(10,12,16,0) 50%, rgba(10,12,16,.7) 100%); }
  .hero__nav { position: relative; }
  .hero__nav .nav__links { color: #fff; }
  .hero__text { position: absolute; left: 0; right: 0; bottom: clamp(32px, 7vh, 56px); }
  .hero__text h1 { margin: 0; max-width: 720px; font-family: var(--serif); font-size: clamp(32px, 5vw, 52px); line-height: 1.1; font-weight: 600; letter-spacing: -0.015em; }
  .hero__caption { position: absolute; right: var(--gutter); top: 84px; font-size: 13px; color: rgba(255,255,255,.8); }

  .col { max-width: calc(720px + 2 * var(--gutter)); }

  .intro { padding-top: 72px; display: flex; flex-direction: column; gap: 14px; }
  .intro p { margin: 0; font-family: var(--serif); font-size: 20px; line-height: 1.55; color: var(--text); }
  .intro .intro__lead { font-size: clamp(24px, 3vw, 30px); line-height: 1.25; font-weight: 600; color: var(--ink); }
  .intro a { text-decoration: underline; text-underline-offset: 3px; text-decoration-thickness: 1px; }
  /* The numbers, large: the proof sits right under the claim. */
  .stats { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 20px; margin: 22px 0 0; }
  .stats div { border-top: 2px solid var(--ink); padding-top: 10px; }
  .stats dt { font-family: var(--serif); font-size: 38px; line-height: 1; font-weight: 700; color: var(--ink); }
  .stats dd { margin: 8px 0 0; font-size: 14px; line-height: 1.35; color: var(--muted); }
  .intro .more { align-self: flex-start; text-decoration: none; }
  @media (max-width: 640px) { .stats { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 22px 18px; } }

  /* Project cards: a picture, one line of proof, the links. */
  .card { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 6fr); gap: 24px; align-items: center; margin-top: 20px; padding: 22px; background: var(--code-bg); border-radius: 10px; }
  .card__shot img { display: block; width: 100%; height: auto; border-radius: 6px; }
  .card__text { display: flex; flex-direction: column; gap: 8px; }
  .card h3 { margin: 0; font-family: var(--serif); font-size: 24px; line-height: 1.2; }
  .card h3 a:hover { text-decoration: underline; text-underline-offset: 4px; text-decoration-thickness: 1px; }
  .card__proof { margin: 0; font-size: 15px; font-weight: 600; color: var(--ink); }
  .card__excerpt { margin: 0; font-family: var(--serif); font-size: 17px; line-height: 1.5; color: var(--muted); }
  .card .meta { margin: 0; }
  .card__links { display: flex; flex-wrap: wrap; gap: 6px 16px; margin: 2px 0 0; font-size: 14px; font-weight: 500; }
  .protos { margin: 20px 0 0; padding: 16px 22px; background: var(--code-bg); border-radius: 10px; font-family: var(--serif); font-size: 18px; line-height: 1.6; color: var(--ink); }
  .protos strong { font-weight: 700; }
  .protos a { font-weight: 600; color: var(--ink); text-decoration: underline; text-underline-offset: 3px; text-decoration-thickness: 1px; }
  .protos .protos__all { margin-left: 6px; font-family: var(--sans); font-size: 15px; font-weight: 500; text-decoration: none; white-space: nowrap; }
  @media (max-width: 640px) { .card { grid-template-columns: 1fr; padding: 18px; gap: 16px; } }

  .block { padding-top: 88px; }
  .block__head { display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 8px; }
  .block__head h2 { margin: 0; font-family: var(--serif); font-size: 26px; }
  .block__lede { margin: 4px 0 0; max-width: 620px; font-family: var(--serif); font-size: 18px; line-height: 1.5; color: var(--text); }
  .block__head a { font-size: 14px; color: var(--faint); }

  .post { display: flex; flex-direction: column; gap: 6px; padding-block: 20px; border-bottom: 0; }
  .post:hover { text-decoration: none; }
  .post:hover .post__title { text-decoration: underline; text-underline-offset: 4px; text-decoration-thickness: 1px; }
  .more { display: inline-block; margin-top: 16px; font-size: 15px; font-weight: 500; }
  .post__title { font-family: var(--serif); font-size: 22px; line-height: 1.25; font-weight: 700; }
  .post__excerpt { font-family: var(--serif); font-size: 17px; line-height: 1.5; color: var(--muted); }

  /* One row of four on desktop and iPad; two by two on a phone. */
  .tiles { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 12px; margin-top: 16px; }
  @media (max-width: 640px) { .tiles { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16px; } }
  .tile { display: flex; flex-direction: column; gap: 8px; }
  .tile img { width: 100%; aspect-ratio: 4 / 3; object-fit: cover; }
  @media (max-width: 560px) { .hero__caption { display: none; } }
</style>
