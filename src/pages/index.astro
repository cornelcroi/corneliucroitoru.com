---
import { Image } from "astro:assets";
import Base from "../layouts/Base.astro";
import PostRow from "../components/PostRow.astro";
import { SITE } from "../site";
import { BUILDING, OPEN_SOURCE } from "../data/projects";
import { EXPERIENCE } from "../data/experience";
import { PHOTO_QUALITY, getAllPosts, getSeries } from "../lib/content";

const LATEST_POSTS = 5;
const PHOTO_TILES = 4;

const posts = (await getAllPosts()).slice(0, LATEST_POSTS);
const series = await getSeries();
const heroSeries = series.find((s) => s.id === SITE.hero.series) ?? series[0];
const hero = heroSeries.data.photos[SITE.hero.photo] ?? heroSeries.data.photos[0];
const tiles = series.filter((s) => s.id !== heroSeries.id).slice(0, PHOTO_TILES);
const photoCount = series.reduce((n, s) => n + s.data.photos.length, 0);
const agentSquad = OPEN_SOURCE[0];
const RECENT_JOBS = 3;
---
<Base overlayNav>
  <header class="hero">
    <Image src={hero.src} alt={`${heroSeries.data.title}`} widths={[800, 1200, 1600, 2000]} sizes="100vw" quality={PHOTO_QUALITY} loading="eager" fetchpriority="high" class="hero__img" />
    <div class="hero__shade"></div>
    <nav class="nav wrap hero__nav" aria-label="Main">
      <a class="nav__name" href="/">{SITE.name}</a>
      <div class="nav__links">
        <a href="/writing/">Writing</a><a href="/projects/">Projects</a><a href="/photography/">Photography</a><a href="/cv/">CV</a><a href="/about/">About</a>
      </div>
    </nav>
    <div class="wrap hero__text">
      <h1>{SITE.tagline}</h1>
    </div>
    <a class="hero__caption" href={`/photography/${heroSeries.id}/`}>{SITE.hero.caption}</a>
  </header>

  <section class="wrap summary">
    <p>23 years of shipping software. The last few, shipping with AI.</p>
    <p>Staff GenAI Solutions Architect at Betclic. Before that, 7 years at AWS: architect for hundreds of customers, then 30+ GenAI prototypes. Always with the path to production in mind. I know what it takes.</p>
    <p>Not just the code. The product, the design, the UX. I like to own it end to end.</p>
    <p>On the side, two travel products in production: <a href="https://streetlensapp.com">StreetLens</a> and <a href="https://www.backfrommytrip.com">Back From My Trip</a>. That is where I test the patterns I write about.</p>
    <p>And I photograph the places I travel to.</p>
  </section>

  <section class="wrap facts" aria-label="In numbers">
    <span><strong>23</strong> years of software</span>
    <span><strong>7</strong> years at AWS</span>
    <span><strong>30+</strong> GenAI prototypes</span>
    <span><strong>7.7k</strong> stars on Agent Squad</span>
    <span>Speaker at <strong>AWS re:Invent</strong></span>
  </section>

  <section class="wrap does" aria-labelledby="does-title">
    <h2 id="does-title" class="eyebrow">What I do</h2>
    <div class="does__grid">
      <div><h3>GenAI systems</h3><p>LLM pipelines, agents, MCP servers. Models where they belong, plain code everywhere else.</p></div>
      <div><h3>Prototype to production</h3><p>Prototypes that survive contact with real users. Serverless, AWS, cost and failure modes from day one.</p></div>
      <div><h3>The product end to end</h3><p>Architecture, code, design, UX. From the first sketch to the thing people use.</p></div>
    </div>
  </section>

  <section class="wrap exp" aria-labelledby="exp-title">
    <h2 id="exp-title" class="eyebrow">Experience</h2>
    {EXPERIENCE.slice(0, RECENT_JOBS).map((job) => (
      <div class="exp__row">
        <span class="meta exp__when">{job.period}</span>
        <div class="exp__what">
          <span class="exp__role">{job.role} · <strong>{job.org}</strong></span>
          <span class="exp__text">{job.summary}</span>
        </div>
      </div>
    ))}
    <div class="exp__row">
      <span class="meta exp__when">2003 – 2018</span>
      <div class="exp__what">
        <span class="exp__role">Software engineer, tech lead, product owner</span>
        <span class="exp__text">Banking and insurance (Société Générale, BNP Paribas), then La Centrale, where I led the move to AWS.</span>
      </div>
    </div>
    <a class="meta exp__more" href="/cv/">Full CV →</a>
  </section>

  <div class="wrap home">
    <main>
      <h2 class="home__title">Writing</h2>
      {posts.map((post) => <PostRow post={post} />)}
      <a class="home__more" href="/writing/">All writing →</a>
    </main>
    <aside class="home__aside">
      <section>
        <h2 class="eyebrow">Side projects</h2>
        {BUILDING.map((p) => (
          <a class="proj" href={p.url}>
            <span class="proj__name">{p.name}</span>
            <span class="meta">{p.line}</span>
          </a>
        ))}
      </section>
      <section>
        <h2 class="eyebrow">Open source</h2>
        <a class="proj" href={agentSquad.url}>
          <span class="proj__name">{agentSquad.name}</span>
          <span class="meta">{agentSquad.line}</span>
        </a>
        <a class="meta" href="/projects/">All projects →</a>
      </section>
      <section>
        <h2 class="eyebrow">Photography</h2>
        <div class="tiles">
          {tiles.map((s) => (
            <a href={`/photography/${s.id}/`} title={s.data.title}>
              <Image src={s.data.cover} alt={s.data.title} width={340} height={220} quality={PHOTO_QUALITY} class="tile" />
            </a>
          ))}
        </div>
        <a class="meta" href="/photography/">{series.length} series, {photoCount} photographs →</a>
      </section>
    </aside>
  </div>
</Base>

<style>
  .hero { position: relative; height: min(720px, 82vh); min-height: 480px; overflow: hidden; color: #fff; }
  .hero__img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .hero__shade { position: absolute; inset: 0; background: linear-gradient(180deg, rgba(10,12,16,.45) 0%, rgba(10,12,16,0) 30%, rgba(10,12,16,0) 50%, rgba(10,12,16,.72) 100%); }
  .hero__nav { position: relative; }
  .hero__nav .nav__links { color: #fff; }
  .hero__text { position: absolute; left: 0; right: 0; bottom: clamp(32px, 7vh, 56px); display: flex; flex-direction: column; gap: 16px; }
  .hero__text h1 { margin: 0; max-width: 760px; font-family: var(--serif); font-size: clamp(32px, 5vw, 52px); line-height: 1.1; font-weight: 600; letter-spacing: -0.015em; }
  .hero__caption { position: absolute; right: var(--gutter); top: 84px; font-size: 13px; color: rgba(255,255,255,.8); }

  .summary { padding-top: 56px; display: flex; flex-direction: column; gap: 14px; }
  .summary p { margin: 0; max-width: 700px; font-family: var(--serif); font-size: clamp(19px, 2vw, 22px); line-height: 1.5; color: var(--text); }
  .summary p:first-child { font-size: clamp(22px, 2.6vw, 28px); line-height: 1.3; color: var(--ink); font-weight: 600; }
  .summary a { text-decoration: underline; text-underline-offset: 3px; text-decoration-thickness: 1px; }

  .facts { display: flex; flex-wrap: wrap; gap: 12px 32px; padding-top: 40px; font-size: 15px; color: var(--faint); }
  .facts strong { color: var(--ink); font-weight: 600; }
  .does { padding-top: 56px; display: flex; flex-direction: column; gap: 20px; }
  .does h2 { margin: 0; font-weight: 400; }
  .does__grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 40px; border-top: 1px solid var(--rule); padding-top: 24px; }
  .does h3 { margin: 0 0 8px; font-size: 18px; font-weight: 600; }
  .does p { margin: 0; font-family: var(--serif); font-size: 17px; line-height: 1.5; color: var(--muted); }
  @media (max-width: 760px) { .does__grid { grid-template-columns: 1fr; gap: 24px; } }

  .exp { padding-top: 56px; display: flex; flex-direction: column; }
  .exp h2 { margin: 0 0 4px; padding-bottom: 12px; border-bottom: 1px solid var(--rule); font-weight: 400; }
  .exp__row { display: grid; grid-template-columns: 170px minmax(0, 1fr); gap: 24px; padding-block: 16px; border-bottom: 1px solid var(--rule); }
  .exp__when { padding-top: 3px; }
  .exp__what { display: flex; flex-direction: column; gap: 4px; }
  .exp__role { font-size: 17px; }
  .exp__role strong { font-weight: 600; }
  .exp__text { font-family: var(--serif); font-size: 17px; line-height: 1.5; color: var(--muted); }
  .exp__more { margin-top: 14px; }
  @media (max-width: 640px) { .exp__row { grid-template-columns: 1fr; gap: 4px; } }

  .home { display: grid; grid-template-columns: minmax(0, 1fr) 320px; gap: clamp(48px, 7vw, 96px); padding-top: 72px; }
  .home__title { margin: 0 0 4px; font-family: var(--serif); font-size: 30px; }
  .home__more { display: inline-block; margin-top: 12px; font-size: 15px; color: var(--faint); }
  .home__aside { display: flex; flex-direction: column; gap: 40px; padding-top: 10px; }
  .home__aside section { display: flex; flex-direction: column; gap: 14px; }
  .home__aside h2 { margin: 0; font-weight: 400; }
  .proj { display: flex; flex-direction: column; gap: 2px; }
  .proj__name { font-weight: 600; font-size: 17px; }
  .tiles { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 8px; }
  .tile { width: 100%; height: 110px; object-fit: cover; }

  @media (max-width: 900px) {
    .home { grid-template-columns: 1fr; }
  }
  @media (max-width: 560px) {
    .hero__caption { display: none; }
  }
</style>
